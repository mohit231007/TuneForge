# TuneForge API
TUNEFORGE_API_KEY=
TUNEFORGE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# Execution backend: local or webhook
TUNEFORGE_EXECUTION_BACKEND=local

# Required only when TUNEFORGE_EXECUTION_BACKEND=webhook
TUNEFORGE_REMOTE_WORKER_URL=
TUNEFORGE_REMOTE_WORKER_TOKEN=

# Public web build/runtime
NEXT_PUBLIC_TUNEFORGE_API_URL=http://localhost:8000

# Optional Hugging Face access for higher rate limits / gated resources
HF_TOKEN=
